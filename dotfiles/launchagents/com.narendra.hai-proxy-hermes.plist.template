<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narendra.hai-proxy-hermes</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/hai</string>
        <string>proxy</string>
        <string>start</string>
        <string>--headless</string>
        <string>--port</string>
        <string>6650</string>
        <string>--use-keyring</string>
        <string>--dangerous-api-key</string>
        <string>__HAI_PROXY_API_KEY__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.hermes/logs/hai-proxy-hermes.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.hermes/logs/hai-proxy-hermes.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>
</dict>
</plist>
