# worldclock — show DE / VN / IN times at a glance
worldclock() {
  for tz in "Germany Europe/Berlin" "Vietnam Asia/Ho_Chi_Minh" "India Asia/Kolkata"; do
    label=${tz% *}; zone=${tz##* }
    printf "%-8s %s\n" "$label" "$(TZ=$zone date '+%Y-%m-%d %H:%M %Z')"
  done
}

# worldclock-live — live-ticking DE / VN / IN clock (Ctrl+C to exit)
worldclock-live() {
  trap 'tput cnorm; echo; return' INT
  tput civis 2>/dev/null
  while true; do
    clear
    echo "🌍 World Clock  (Ctrl+C to exit)"
    echo "--------------------------------"
    for tz in "Germany Europe/Berlin" "Vietnam Asia/Ho_Chi_Minh" "India Asia/Kolkata"; do
      label=${tz% *}; zone=${tz##* }
      printf "%-8s %s\n" "$label" "$(TZ=$zone date '+%Y-%m-%d %H:%M:%S %Z')"
    done
    sleep 1
  done
}

