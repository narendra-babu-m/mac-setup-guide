# ================================================================
# VS Code / non-interactive shell fast-path
# When VS Code resolves the shell environment (or any non-interactive
# login), skip heavy interactive-only stuff. Just export PATH + core envs
# and exit. This kills the "Unable to resolve shell env in reasonable
# time" banner. Full config still loads for real interactive shells.
# ================================================================
if [[ -n "$VSCODE_RESOLVING_ENVIRONMENT" ]] || [[ -n "$VSCODE_SHELL_ENV_REPORT" ]] || [[ ! -o interactive ]]; then
  # Minimal envs VS Code actually needs
  export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
  export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
  export PATH="/usr/local/opt/openjdk@17/bin:$PATH"
  export PATH="$HOME/.pyenv/shims:$HOME/.pyenv/bin:$PATH"
  export PATH="/opt/homebrew/Caskroom/miniforge/base/bin:$PATH"
  export NVM_DIR="$HOME/.nvm"
  export PYENV_ROOT="$HOME/.pyenv"
  export HERMES_SKIP_SSL_GUARD=1
  return 0
fi

