# >>> conda initialize (LAZY — was ~800ms on shell start) >>>
# Real conda hook only loads when you actually type `conda` or activate an env
export CONDA_ROOT="/opt/homebrew/Caskroom/miniforge/base"
export PATH="$CONDA_ROOT/bin:$PATH"
conda() {
  unset -f conda
  __conda_setup="$('$CONDA_ROOT/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    [ -f "$CONDA_ROOT/etc/profile.d/conda.sh" ] && . "$CONDA_ROOT/etc/profile.d/conda.sh"
  fi
  unset __conda_setup
  conda "$@"
}
